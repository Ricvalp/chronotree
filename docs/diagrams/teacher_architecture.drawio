          <mxGeometry as="geometry" x="48" y="230" width="1600" height="35" />
        </mxCell>
        <object id="encoders-9" label="&lt;b&gt;Per-frame point cloud&lt;/b&gt;&lt;br&gt;&lt;br&gt;N ≤ 1,024 · XYZRGB&lt;br&gt;6 channels per point&lt;br&gt;World coordinates + mask" tooltip="Per-frame point cloud&#10;N ≤ 1,024 · XYZRGB&#10;6 channels per point&#10;World coordinates + mask">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="48" y="370" width="245" height="155" />
          </mxCell>
        </object>
        <object id="encoders-10" label="&lt;b&gt;Point MLP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Linear 6 → 256&lt;br&gt;SiLU → Linear 256 → 256" tooltip="spacetime_encoder.py: SpacetimeEncoder.point_mlp. 67,584 trainable parameters; applied independently to each point.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="365" y="285" width="285" height="135" />
          </mxCell>
        </object>
        <object id="encoders-11" label="&lt;b&gt;Observed centers + neighbors&lt;/b&gt;&lt;br&gt;&lt;br&gt;FPS: 4/historical frame&lt;br&gt;or 64/current frame&lt;br&gt;≤128 neighbors per center&lt;br&gt;Radius 0.3 m; Δt ≤ 8 frames" tooltip="spacetime_encoder.py + batched_spacetime.py. Deterministic FPS on observed XYZ, independent per frame. Candidate neighbors are restricted to the same source, example and block. Temporal distance uses source-local recorded frames, not seconds. Centers sample spatial extent; they are not semantic object or robot keypoints.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="365" y="480" width="285" height="190" />
          </mxCell>
        </object>
        <object id="encoders-12" label="&lt;b&gt;Gather local edge features&lt;/b&gt;&lt;br&gt;&lt;br&gt;Point feature 256&lt;br&gt;+ relative XYZ (3)&lt;br&gt;+ relative time (1) = 260" tooltip="Gather local edge features&#10;Point feature 256&#10;+ relative XYZ (3)&#10;+ relative time (1) = 260">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="735" y="370" width="285" height="155" />
          </mxCell>
        </object>
        <object id="encoders-13" label="&lt;b&gt;Edge MLP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Linear 260 → 256&lt;br&gt;SiLU → Linear 256 → 256" tooltip="spacetime_encoder.py: SpacetimeEncoder.edge_mlp. 132,608 trainable parameters.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="1100" y="370" width="270" height="155" />
          </mxCell>
        </object>
        <object id="encoders-14" label="&lt;b&gt;Gaussian weighted pool&lt;/b&gt;&lt;br&gt;&lt;br&gt;Softmax over valid neighbors&lt;br&gt;1 vector of width 256/center&lt;br&gt;Learned positive τx and τt&lt;br&gt;Initial τx=0.01 m²; τt=4 frames²" tooltip="Gaussian score = −||ΔXYZ||²/τx − Δt²/τt; softmax-weighted sum of edge features. τx and τt use softplus plus a small positive floor. This is one local pooling stage.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
