        <mxCell id="encoders-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="encoders-17" target="encoders-18">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <object id="encoders-26" label="&lt;b&gt;Historical block: up to 256 visual leaves  •  Current: up to 32&lt;/b&gt;&lt;br&gt;&lt;br&gt;Separate 8-frame blocks per source; prefixes contain only observed frames.&lt;br&gt;Only points and center indices are prepared; learned content is recomputed." tooltip="Historical block: up to 256 visual leaves  •  Current: up to 32&#10;Separate 8-frame blocks per source; prefixes contain only observed frames.&#10;Only points and center indices are prepared; learned content is recomputed.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="notes">
            <mxGeometry as="geometry" x="820" y="680" width="932" height="125" />
          </mxCell>
        </object>
        <mxCell id="encoders-27" value="B  EVENT ENCODER  /  One token per historical frame" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#475569;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="930" width="1600" height="35" />
