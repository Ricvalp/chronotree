        <object id="decoder-11" label="&lt;b&gt;Flow interpolation time u&lt;/b&gt;&lt;br&gt;&lt;br&gt;16 sine + 16 cosine features&lt;br&gt;Linear 32 → 256 → SiLU&lt;br&gt;Linear 256 → 256" tooltip="action_flow.py: ActionFlow.time_in. u is the flow interpolation time; it is independent of the source-local episode clocks in the observation context.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="48" y="495" width="340" height="175" />
          </mxCell>
        </object>
        <object id="decoder-12" label="&lt;b&gt;Add query embeddings&lt;/b&gt;&lt;br&gt;&lt;br&gt;16 action-query tokens&lt;br&gt;Shape [B, 16, 256]" tooltip="Add query embeddings&#10;16 action-query tokens&#10;Shape [B, 16, 256]">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
