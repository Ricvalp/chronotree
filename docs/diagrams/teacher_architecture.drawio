        <mxCell id="frozen-9" value="CHRONOTREE  /  Matched FV-Prop / FV-NoProp experiment     •     Click page tabs or linked blocks · hover for details · all shapes are editable" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;fontColor=#64748B;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="2522" width="1690" height="30" />
        </mxCell>
        <mxCell id="frozen-10" value="01  SAME FRAME-LOCAL VISUAL PIPELINE IN BOTH ARMS" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#475569;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="225" width="1704" height="35" />
        </mxCell>
        <object id="frozen-11" label="&lt;b&gt;Observed RGB-D only&lt;/b&gt;&lt;br&gt;&lt;br&gt;Front + wrist RGB, each 256 × 256&lt;br&gt;Backproject → crop → voxel/sample&lt;br&gt;Canonical XYZRGB stays [2048, 6]&lt;br&gt;Save source camera + original (u,v)&lt;br&gt;Padding validity follows each point" tooltip="Online pointcloud.py carries source camera/pixel indices through geometry-only selection. Offline feature preparation recovers pixels for unchanged canonical points, verifying exact RGB and recorded-depth backprojection within 1 micrometre per coordinate; missing or ambiguous matches fail. No object labels or unseen pixels are used.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="48" y="285" width="310" height="250" />
          </mxCell>
        </object>
        <object id="frozen-12" label="&lt;b&gt;Frozen CLIP RN50 · layer1&lt;/b&gt;&lt;br&gt;&lt;br&gt;RGB normalization; no crop/resize&lt;br&gt;3-convolution stem + average pool&lt;br&gt;First 3 residual bottlenecks&lt;br&gt;Per-camera [256, 64, 64] feature map&lt;br&gt;Stride 4; origin at input pixel (1,1)&lt;br&gt;Eval mode, including BatchNorm" tooltip="vision/frozen.py loads the SHA256-pinned OpenAI RN50 artifact, retaining stem and layer1 only. Parameters have no gradients; training uses cached descriptors, online rollout executes the frozen image encoder.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="430" y="285" width="365" height="250" />
          </mxCell>
        </object>
        <object id="frozen-13" label="&lt;b&gt;Sample source-camera features&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bilinear sample at saved pixel (u,v)&lt;br&gt;Raw descriptors [2048, 256]&lt;br&gt;FP16 sidecar; invalid rows zero&lt;br&gt;Identity includes weights + mapping&lt;br&gt;Read only requested episode/frame&lt;br&gt;No trainable projection in cache" tooltip="feature_cache.py aligns each descriptor with the exact prepared point index. Offline and online paths share normalization, sampling and FP16 descriptor rounding. No future frame enters an individual image encoding.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="875" y="285" width="365" height="250" />
          </mxCell>
        </object>
        <object id="frozen-14" label="&lt;b&gt;Trainable point representation&lt;/b&gt;&lt;br&gt;&lt;br&gt;LayerNorm 256 → Linear 256 → 128&lt;br&gt;Concatenate XYZ + RGB + descriptor&lt;br&gt;Point MLP: 134 → 256 → 256&lt;br&gt;Same edge MLP + Gaussian pooling&lt;br&gt;Distances/anchors use only XYZ&lt;br&gt;Geometry and reductions remain FP32" tooltip="spacetime_encoder.py and batched_spacetime.py. The new descriptor projection and point encoder are optimized; the frozen RGB backbone is excluded from the optimizer. Shared center indices, quotas, neighborhoods and temporal groups do not depend on descriptors.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="1320" y="285" width="432" height="250" />
          </mxCell>
        </object>
        <mxCell id="frozen-15" value="RGB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="frozen-11" target="frozen-12">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="frozen-16" value="dense map" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="frozen-12" target="frozen-13">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="frozen-17" value="raw features" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="frozen-13" target="frozen-14">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <object id="frozen-18" label="&lt;b&gt;Geometry, visibility and causality stay matched&lt;/b&gt;&lt;br&gt;&lt;br&gt;Both arms: ≤2048 observed points/frame; nominal 75% above-table quota; ≤32 balanced centers/frame; 256 visual leaves/full 8-frame block.&lt;br&gt;Conditioning and execution remain separate; history strictly precedes current t. Current appears once. No removed state slot becomes a visual token.&lt;br&gt;Robot pixels, depth and calibration remain. Visual XYZ/time/source metadata and clock tokens remain; their ablation is a separate follow-up." tooltip="Geometry, visibility and causality stay matched&#10;Both arms: ≤2048 observed points/frame; nominal 75% above-table quota; ≤32 balanced centers/frame; 256 visual leaves/full 8-frame block.&#10;Conditioning and execution remain separate; history strictly precedes current t. Current appears once. No removed state slot becomes a visual token.&#10;Robot pixels, depth and calibration remain. Visual XYZ/time/source metadata and clock tokens remain; their ablation is a separate follow-up.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="48" y="580" width="1704" height="130" />
          </mxCell>
        </object>
        <mxCell id="frozen-19" value="02  COMPLETE COMMAND REMOVAL IN BOTH ARMS  /  MEASURED-STATE INPUT IS THE CONTROLLED DIFFERENCE" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#475569;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="760" width="1704" height="35" />
        </mxCell>
        <object id="frozen-20" label="&lt;b&gt;FV-Prop · required matched control&lt;/b&gt;&lt;br&gt;&lt;br&gt;Measured joints, TCP pose and gripper state retained.&lt;br&gt;Current state MLP gets [15 measured values, 9 fixed zeros].&lt;br&gt;Historical event content uses measured-state branch only.&lt;br&gt;Historical event anchor/bounds retain measured TCP XYZ.&lt;br&gt;Previous joints, gripper command and availability all disabled.&lt;br&gt;≤33(Hc + He) + 35 valid context tokens; masked batch padding.&lt;br&gt;6,100,618 active trainable policy parameters&lt;br&gt;68,352 inactive stored parameters; frozen RGB encoder separate" tooltip="configs/teacher_fv_prop.yaml. model.proprioception_mode=all, condition_on_previous_commands=false. Inactive command-branch weights are initialized for matching but frozen and excluded from optimization.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="48" y="820" width="804" height="350" />
          </mxCell>
        </object>
        <object id="frozen-21" label="&lt;b&gt;FV-NoProp · primary candidate&lt;/b&gt;&lt;br&gt;&lt;br&gt;No explicit numerical robot state reaches the learned policy.&lt;br&gt;Current state token removed; goal and clock tokens retained.&lt;br&gt;Historical event tokens removed, including state-derived XYZ.&lt;br&gt;Router numerical state/command inputs are fixed zeros.&lt;br&gt;Previous joints, gripper command and availability all disabled.&lt;br&gt;≤32(Hc + He) + 34 valid context tokens; masked batch padding.&lt;br&gt;5,892,746 active trainable policy parameters&lt;br&gt;276,224 inactive stored parameters; frozen RGB encoder separate" tooltip="configs/teacher_fv_no_prop.yaml. model.proprioception_mode=none. Raw-state mutation checks rebuild archives and metadata. Zeroing only the state MLP would leave historical TCP anchors as a leak; these tokens are removed entirely.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="930" y="820" width="822" height="350" />
          </mxCell>
        </object>
        <object id="frozen-22" label="&lt;b&gt;03  BASE 20 Hz RECIPE · SAME DECODER, FRESH TRAINING AND DEVELOPMENT PROTOCOL&lt;/b&gt;&lt;br&gt;&lt;br&gt;FULL teacher reads every causal visual leaf. Action flow predicts H=32 native 20 Hz joint commands; execute K=4, then replan.&lt;br&gt;4 B200s · effective batch 128 · microbatch 8/GPU · encoder block batch 32 · activation checkpointing off&lt;br&gt;AdamW, LR 0.0001 · 100,000 updates · compare 25k / 50k / 100k · same seed, sample order and fixed validation scenes&lt;br&gt;Autonomous first grasp/lift and target error are diagnostics; full task success remains distinct. No new masks, expert recovery or target-pose inputs." tooltip="03  BASE 20 Hz RECIPE · SAME DECODER, FRESH TRAINING AND DEVELOPMENT PROTOCOL&#10;FULL teacher reads every causal visual leaf. Action flow predicts H=32 native 20 Hz joint commands; execute K=4, then replan.&#10;4 B200s · effective batch 128 · microbatch 8/GPU · encoder block batch 32 · activation checkpointing off&#10;AdamW, LR 0.0001 · 100,000 updates · compare 25k / 50k / 100k · same seed, sample order and fixed validation scenes&#10;Autonomous first grasp/lift and target error are diagnostics; full task success remains distinct. No new masks, expert recovery or target-pose inputs." link="data:page/id,decoder">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="48" y="1225" width="1704" height="190" />
          </mxCell>
        </object>
        <object id="frozen-23" label="&lt;b&gt;Resource and interpretation boundaries&lt;/b&gt;&lt;br&gt;&lt;br&gt;External frozen image encoder: 244,576 parameters&lt;br&gt;FP16 descriptors: 1 MiB/frame, stored uncompressed.&lt;br&gt;Two full FP32 feature maps: 8 MiB transient/frame.&lt;br&gt;Cache I/O and online CLIP latency must be measured.&lt;br&gt;FV-NoProp vs FV-Prop isolates explicit state removal&lt;br&gt;under frozen vision, not the benefit of visual pretraining." tooltip="Resource and interpretation boundaries&#10;External frozen image encoder: 244,576 parameters&#10;FP16 descriptors: 1 MiB/frame, stored uncompressed.&#10;Two full FP32 feature maps: 8 MiB transient/frame.&#10;Cache I/O and online CLIP latency must be measured.&#10;FV-NoProp vs FV-Prop isolates explicit state removal&#10;under frozen vision, not the benefit of visual pretraining.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="notes">
            <mxGeometry as="geometry" x="48" y="1465" width="804" height="230" />
          </mxCell>
        </object>
        <mxCell id="frozen-24" value="04  OPTIONAL 10 Hz OBSERVATION + ACTION EXPERIMENT" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#475569;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1745" width="1704" height="35" />
        </mxCell>
        <object id="frozen-25" label="&lt;b&gt;teacher_fv_prop_10hz.yaml / teacher_fv_no_prop_10hz.yaml · fresh, separate runs&lt;/b&gt;&lt;br&gt;&lt;br&gt;Retain every 2nd source frame; original clocks remain 0, 2, 4, … in native 20 Hz units. Conditioning/execution phases stay separate.&lt;br&gt;History blocks retain 8 sampled frames and ≤256 visual leaves. The full retained history remains available; no eight-block truncation.&lt;br&gt;Predict H=16 absolute targets at 10 Hz; hold each for 2 native simulator steps. Execute 2 targets = 4 native steps, then replan.&lt;br&gt;Post-action target phase: a[t+1], a[t+3], …; mask all intervening invalid commands and incomplete hold intervals. Check termination every native step.&lt;br&gt;Reuse full-rate XYZRGB and CLIP caches. Same per-frame centers, optimizer and batch settings. Fewer history frames, not fewer centers per retained frame.&lt;br&gt;This changes the temporal experiment: nominal chunk coverage stays ~1.6 s; eight-frame blocks cover ~0.8 s. Preserve original time metadata and causal boundaries." tooltip="configs/teacher_fv_prop_10hz.yaml and teacher_fv_no_prop_10hz.yaml. observation_stride=2, action_stride=2, horizon=16, execute=2, block_size=8. The simulator still steps at20Hz; every native command/terminal status is counted. Sparse action supervision never jumps over invalid primitive commands. Existing20Hz experiments remain separate.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="48" y="1805" width="1704" height="230" />
          </mxCell>
        </object>
        <object id="frozen-26" label="&lt;b&gt;Legacy defaults and later readers&lt;/b&gt;&lt;br&gt;&lt;br&gt;Existing XYZRGB checkpoint loading and token counts remain.&lt;br&gt;Old seven-joint ablation still retains command gripper/mask.&lt;br&gt;These new arms use the stronger complete-command switch.&lt;br&gt;Optional current_only mode retains current measured state&lt;br&gt;and removes historical state; it is not a required third run.&lt;br&gt;TREE/FLAT must later reuse the same selected recipe/leaves." tooltip="Legacy defaults and later readers&#10;Existing XYZRGB checkpoint loading and token counts remain.&#10;Old seven-joint ablation still retains command gripper/mask.&#10;These new arms use the stronger complete-command switch.&#10;Optional current_only mode retains current measured state&#10;and removes historical state; it is not a required third run.&#10;TREE/FLAT must later reuse the same selected recipe/leaves.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="notes">
            <mxGeometry as="geometry" x="930" y="1465" width="822" height="230" />
          </mxCell>
        </object>
        <mxCell id="frozen-27" value="05  TRAINING I/O · SAME RAW FEATURES, MODEL AND CAUSAL CONTEXT" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#475569;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="2085" width="1704" height="35" />
        </mxCell>
        <object id="frozen-28" label="&lt;b&gt;Immutable descriptor sidecars&lt;/b&gt;&lt;br&gt;&lt;br&gt;Shared storage works by default.&lt;br&gt;Optional explicit node-local scratch:&lt;br&gt;locked, verified, atomic staging.&lt;br&gt;Physical path override only; same identity.&lt;br&gt;No geometry, weights or learned cache copied.&lt;br&gt;Checkpoints/logs keep the durable run root." tooltip="data/stage_features.py. STMEM_SCRATCH_ROOT must name an available writable site-provided location. STMEM_FEATURE_CACHE_ROOT redirects raw sidecar readers without mutating scientific configuration. Dry-run generation never stages data; insufficient storage is reported before training.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="48" y="2145" width="500" height="300" />
          </mxCell>
        </object>
        <object id="frozen-29" label="&lt;b&gt;Bounded descriptor producer · CPU&lt;/b&gt;&lt;br&gt;&lt;br&gt;DataLoader sends lightweight row references.&lt;br&gt;Producer reads upcoming encoder chunks.&lt;br&gt;Default queue: 2 chunks per training rank.&lt;br&gt;Reusable pinned host buffers on CUDA.&lt;br&gt;Separate from geometry worker prefetch.&lt;br&gt;No whole-episode descriptor queue." tooltip="data/feature_prefetch.py and models/batched_policy.py. STMEM_FEATURE_PREFETCH_CHUNKS=0 selects synchronous loading. Queued bytes follow the existing packed row indices; fetching later work early does not expose future frames to the current decision.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="640" y="2145" width="500" height="300" />
          </mxCell>
        </object>
        <object id="frozen-30" label="&lt;b&gt;Asynchronous transfer → same encoder&lt;/b&gt;&lt;br&gt;&lt;br&gt;CUDA copy stream overlaps H2D with work.&lt;br&gt;Consumer waits for its own copy event.&lt;br&gt;Host buffers reused after copy completes.&lt;br&gt;GPU descriptors stay valid through backward.&lt;br&gt;Projection and full-history encoding trained.&lt;br&gt;No change to masks, loss or checkpoint shape." tooltip="The I/O pipeline never caches learned projection outputs, drops historical leaves or reuses mutable GPU storage needed by autograd. A CUDA event orders each consuming stream after its copy; pinned host storage is not overwritten during transfer. These are runtime controls, not a new scientific experiment.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="1232" y="2145" width="520" height="300" />
          </mxCell>
        </object>
        <mxCell id="frozen-31" value="raw FP16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="frozen-28" target="frozen-29">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="frozen-32" value="pinned CPU" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="frozen-29" target="frozen-30">
          <mxGeometry as="geometry" relative="1" />
