        </object>
        <object id="decoder-13" label="&lt;b&gt;4 decoder blocks in sequence&lt;/b&gt;&lt;br&gt;&lt;br&gt;Block 1 → … → Block 4&lt;br&gt;Each preserves [B, 16, 256]&lt;br&gt;1,053,440 parameters/block&lt;br&gt;Independent weights per block&lt;br&gt;Every block reads the same context" tooltip="4 decoder blocks in sequence&#10;Block 1 → … → Block 4&#10;Each preserves [B, 16, 256]&#10;1,053,440 parameters/block&#10;Independent weights per block&#10;Every block reads the same context">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="910" y="270" width="390" height="270" />
          </mxCell>
        </object>
        <object id="decoder-14" label="&lt;b&gt;Full observation context&lt;/b&gt;&lt;br&gt;&lt;br&gt;[B, L, 256] + validity mask&lt;br&gt;All fine leaves + current/auxiliary" tooltip="Full observation context&#10;[B, L, 256] + validity mask&#10;All fine leaves + current/auxiliary" link="data:page/id,context">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="910" y="620" width="390" height="135" />
          </mxCell>
        </object>
        <object id="decoder-15" label="&lt;b&gt;Output projection&lt;/b&gt;&lt;br&gt;&lt;br&gt;LayerNorm → Linear 256 → 8&lt;br&gt;Velocity vθ · [B, 16, 8]&lt;br&gt;7 arm joints + gripper" tooltip="Output is velocity in normalized action space, not a Cartesian end-effector position or a raw joint command. The flow solver and action normalizer convert it.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="1410" y="305" width="342" height="180" />
          </mxCell>
        </object>
        <mxCell id="decoder-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B45309;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="decoder-10" target="decoder-12">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="decoder-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B45309;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="decoder-11" target="decoder-12">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="decoder-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B45309;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="decoder-12" target="decoder-13">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="decoder-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="decoder-14" target="decoder-13">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="decoder-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B45309;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="decoder-13" target="decoder-15">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <object id="decoder-21" label="&lt;b&gt;Attention dimensions&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 heads × 32 features/head&lt;br&gt;Self: 16 queries ↔ 16 queries&lt;br&gt;Cross: 16 queries → L context&lt;br&gt;No history-to-history attention" tooltip="Attention dimensions&#10;8 heads × 32 features/head&#10;Self: 16 queries ↔ 16 queries&#10;Cross: 16 queries → L context&#10;No history-to-history attention">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="notes">
            <mxGeometry as="geometry" x="1410" y="565" width="342" height="190" />
          </mxCell>
        </object>
        <object id="decoder-22" label="&lt;b&gt;ATTENTION DIAGNOSTICS  /  Fixed training-scene inference probes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Every 10 optimizer updates by default; fixed noise, final Euler evaluation at u = 0.875.&lt;br&gt;Cross-attention mass: current visual/state, goal/clock, historical visual/robot-event tokens.&lt;br&gt;Conditional entropy is normalized within each group before averaging heads, queries and layers.&lt;br&gt;Uniform token-count baselines account for longer histories. Attention weight alone is not causal importance.&lt;br&gt;Detached Q/K statistics leave SDPA and learned parameters unchanged; runtime cadence is resume-safe." tooltip="training/attention.py and models/attention_diagnostics.py. Fixed probes do not expose expert targets to inference. Diagnostic work is separate from the optimization update and timed explicitly.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="notes">
            <mxGeometry as="geometry" x="48" y="1800" width="1704" height="225" />
          </mxCell>
        </object>
        <mxCell id="decoder-23" value="INSIDE EACH DECODER BLOCK  /  Pre-normalized residual sublayers" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#475569;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="820" width="1650" height="35" />
        </mxCell>
        <object id="decoder-24" label="&lt;b&gt;1  Query self-attention&lt;/b&gt;&lt;br&gt;&lt;br&gt;y = LayerNorm(x)&lt;br&gt;Q, K, V from the 16 query tokens&lt;br&gt;8 heads → output projection&lt;br&gt;x ← x + SelfAttention(y, y)" tooltip="1  Query self-attention&#10;y = LayerNorm(x)&#10;Q, K, V from the 16 query tokens&#10;8 heads → output projection&#10;x ← x + SelfAttention(y, y)">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="48" y="890" width="490" height="195" />
          </mxCell>
        </object>
        <object id="decoder-25" label="&lt;b&gt;2  Context cross-attention&lt;/b&gt;&lt;br&gt;&lt;br&gt;Q = projected LayerNorm(x)&lt;br&gt;K, V = projected observation context&lt;br&gt;Invalid context slots have −∞ bias&lt;br&gt;x ← x + CrossAttention(Q, context)" tooltip="2  Context cross-attention&#10;Q = projected LayerNorm(x)&#10;K, V = projected observation context&#10;Invalid context slots have −∞ bias&#10;x ← x + CrossAttention(Q, context)">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="655" y="890" width="490" height="195" />
          </mxCell>
        </object>
        <object id="decoder-26" label="&lt;b&gt;3  Feed-forward network&lt;/b&gt;&lt;br&gt;&lt;br&gt;y = LayerNorm(x)&lt;br&gt;Linear 256 → 1024 → GELU&lt;br&gt;Linear 1024 → 256&lt;br&gt;x ← x + FFN(y)" tooltip="3  Feed-forward network&#10;y = LayerNorm(x)&#10;Linear 256 → 1024 → GELU&#10;Linear 1024 → 256&#10;x ← x + FFN(y)">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="1262" y="890" width="490" height="195" />
          </mxCell>
        </object>
        <mxCell id="decoder-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B45309;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="decoder-24" target="decoder-25">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="decoder-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B45309;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="decoder-25" target="decoder-26">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <object id="decoder-29" label="&lt;b&gt;TRAINING  /  One sampled flow time per example&lt;/b&gt;&lt;br&gt;&lt;br&gt;y = normalized ground-truth action chunk&lt;br&gt;ε ∼ Normal(0, I);   u ∼ Uniform(0, 1)&lt;br&gt;xᵤ = (1 − u) ε + u y;   target velocity = y − ε&lt;br&gt;One decoder evaluation predicts vθ(xᵤ, u | context).&lt;br&gt;MSE over valid action dimensions within each example;&lt;br&gt;then average examples equally. Padding has zero loss.&lt;br&gt;Future actions are supervision; future observations are excluded." tooltip="TRAINING  /  One sampled flow time per example&#10;y = normalized ground-truth action chunk&#10;ε ∼ Normal(0, I);   u ∼ Uniform(0, 1)&#10;xᵤ = (1 − u) ε + u y;   target velocity = y − ε&#10;One decoder evaluation predicts vθ(xᵤ, u | context).&#10;MSE over valid action dimensions within each example;&#10;then average examples equally. Padding has zero loss.&#10;Future actions are supervision; future observations are excluded.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="notes">
            <mxGeometry as="geometry" x="48" y="1160" width="810" height="325" />
          </mxCell>
        </object>
        <object id="decoder-30" label="&lt;b&gt;INFERENCE  /  Receding-horizon control&lt;/b&gt;&lt;br&gt;&lt;br&gt;Start with a Gaussian action chunk at flow time u = 0.&lt;br&gt;Apply 8 Euler steps with the same decoder weights.&lt;br&gt;Δu = 1/8;   x ← x + Δu · vθ(x, u | context)&lt;br&gt;Denormalize the resulting 16 × 8 action chunk.&lt;br&gt;Execute the first 4 commands, then observe and replan.&lt;br&gt;The observation context is shared across the flow evaluations.&lt;br&gt;Training does not run this whole Euler loop for each example." tooltip="INFERENCE  /  Receding-horizon control&#10;Start with a Gaussian action chunk at flow time u = 0.&#10;Apply 8 Euler steps with the same decoder weights.&#10;Δu = 1/8;   x ← x + Δu · vθ(x, u | context)&#10;Denormalize the resulting 16 × 8 action chunk.&#10;Execute the first 4 commands, then observe and replan.&#10;The observation context is shared across the flow evaluations.&#10;Training does not run this whole Euler loop for each example.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="notes">
            <mxGeometry as="geometry" x="920" y="1160" width="832" height="325" />
          </mxCell>
        </object>
        <object id="decoder-31" label="&lt;b&gt;OPTIONAL H32 TEACHER  /  Previous commanded joints disabled&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chunk [B, 32, 8]; learned positions [32, 256]. Execute 4 commands before replanning; control cadence is unchanged.&lt;br&gt;6,102,794 parameters (+4,096 versus the core teacher). All visual/history encoders and causal boundaries are preserved.&lt;br&gt;4 B200s: effective batch 128, microbatch 8/GPU, encoder block batch 32; LR 0.0001, 100,000 updates.&lt;br&gt;This is a separate fresh-training experiment. The main diagram remains the H16 core configuration." tooltip="configs/teacher_b200_b128_m8_blocks32_no_previous_joint_commands_h32.yaml. Prepared frame geometry is reused. Future actions remain supervision only; target padding stays masked. Previous gripper command and measured state remain available.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="notes">
            <mxGeometry as="geometry" x="48" y="1540" width="1704" height="210" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
