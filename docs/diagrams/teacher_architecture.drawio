        <mxCell id="encoders-9" value="CHRONOTREE  /  Teacher · configs/teacher.yaml     •     Click page tabs or linked blocks · hover for details · all shapes are editable" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;fontColor=#64748B;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1722" width="1690" height="30" />
        </mxCell>
        <mxCell id="encoders-10" value="A0  OBSERVED GEOMETRY" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#475569;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="230" width="350" height="35" />
        </mxCell>
        <mxCell id="encoders-11" value="A1  SHARED VISUAL ENCODER  /  History and current frame" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#475569;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="230" width="1312" height="35" />
        </mxCell>
        <object id="encoders-12" label="&lt;b&gt;Calibrated point cloud&lt;/b&gt;&lt;br&gt;&lt;br&gt;N ≤ 2,048 · XYZRGB + mask&lt;br&gt;75% elevated; rest broad-scene&lt;br&gt;XY cells 0.1 m; voxels 5 mm&lt;br&gt;Elevated: world z &amp;gt; 0.005 m&lt;br&gt;Front + wrist; fixed crop" tooltip="pointcloud.py: observed RGB-D is backprojected into calibrated world coordinates. Point sampling reserves an elevated-geometry quota and retains broad-scene coverage. No simulator object IDs, masks, or hidden poses are inputs.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="48" y="300" width="300" height="220" />
          </mxCell>
        </object>
        <object id="encoders-13" label="&lt;b&gt;Frame-local center indices&lt;/b&gt;&lt;br&gt;&lt;br&gt;≤32 anchors; target 24 elevated + 8 broad&lt;br&gt;Cell-balanced centroid refinement&lt;br&gt;Snap to observed point positions&lt;br&gt;XYZ cells: 0.1 m&lt;br&gt;≤20 iterations per stage&lt;br&gt;Prepared once; shared online rule" tooltip="center_sampling.py: deterministic stratified FPS initializes two refinement stages. Each occupied world XYZ cell has total weight one. Elevated anchors are refined first, then held fixed while broad-scene anchors refine residual coverage. Each centroid is snapped to an observed member point. The cached indices depend only on this frame. Preparation stores center_indices/&lt;quota&gt;; CPU loader workers reuse them. Online RGB-D observations use the same selector once per acquired frame.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="48" y="555" width="300" height="260" />
          </mxCell>
        </object>
        <object id="encoders-14" label="&lt;b&gt;Point MLP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Linear 6 → 256&lt;br&gt;SiLU → Linear 256 → 256" tooltip="spacetime_encoder.py: SpacetimeEncoder.point_mlp. 67,584 trainable parameters; applied independently to each point.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="440" y="300" width="300" height="145" />
          </mxCell>
        </object>
        <object id="encoders-15" label="&lt;b&gt;Gather bounded neighborhoods&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reuse prepared center indices&lt;br&gt;32/historical or 32/current frame&lt;br&gt;≤128 neighbors per center&lt;br&gt;Radius 0.3 m; Δt ≤ 8 frames&lt;br&gt;Same source, example and block" tooltip="spacetime_encoder.py + batched_spacetime.py. The shared per-frame observed-point indices choose anchors; the encoder constructs exact bounded Gaussian neighborhoods from the currently available block or prefix. Pooling neighbors are not clustering assignments. Temporal distance uses source-local recorded frames, not seconds. Centers are geometric samples, not semantic object or robot keypoints. Batched neighbor ranking runs without autograd; selected-neighbor distances are then evaluated with gradients for the learned bandwidths and observed inputs.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="440" y="555" width="300" height="230" />
          </mxCell>
        </object>
        <object id="encoders-16" label="&lt;b&gt;Gather local edge features&lt;/b&gt;&lt;br&gt;&lt;br&gt;Point feature 256&lt;br&gt;+ relative XYZ (3)&lt;br&gt;+ relative time (1) = 260" tooltip="Gather local edge features&#10;Point feature 256&#10;+ relative XYZ (3)&#10;+ relative time (1) = 260">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="820" y="415" width="270" height="170" />
          </mxCell>
        </object>
        <object id="encoders-17" label="&lt;b&gt;Edge MLP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Linear 260 → 256&lt;br&gt;SiLU → Linear 256 → 256" tooltip="spacetime_encoder.py: SpacetimeEncoder.edge_mlp. 132,608 trainable parameters.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="1150" y="415" width="250" height="170" />
          </mxCell>
        </object>
        <object id="encoders-18" label="&lt;b&gt;Gaussian weighted pool&lt;/b&gt;&lt;br&gt;&lt;br&gt;Softmax over valid neighbors&lt;br&gt;1 vector of width 256/center&lt;br&gt;Learned positive τx and τt&lt;br&gt;Initial τx=0.01 m²; τt=4 frames²" tooltip="Gaussian score = −||ΔXYZ||²/τx − Δt²/τt; softmax-weighted sum of edge features. τx and τt use softplus plus a small positive floor. This is one local pooling stage.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="1465" y="415" width="287" height="215" />
          </mxCell>
        </object>
        <mxCell id="encoders-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="encoders-12" target="encoders-14">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="encoders-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="encoders-12" target="encoders-13">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="encoders-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="encoders-13" target="encoders-15">
          <mxGeometry as="geometry" relative="1" />
