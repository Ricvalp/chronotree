        <object id="decoder-11" label="&lt;b&gt;4 decoder blocks in sequence&lt;/b&gt;&lt;br&gt;&lt;br&gt;Block 1 → … → Block 4&lt;br&gt;Each preserves [B, 16, 256]&lt;br&gt;1,053,440 parameters/block&lt;br&gt;Independent weights per block&lt;br&gt;Every block reads the same context" tooltip="4 decoder blocks in sequence&#10;Block 1 → … → Block 4&#10;Each preserves [B, 16, 256]&#10;1,053,440 parameters/block&#10;Independent weights per block&#10;Every block reads the same context">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
