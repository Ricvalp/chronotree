          </mxCell>
        </object>
        <mxCell id="encoders-26" value="B  EVENT ENCODER  /  One token per historical frame" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=19;fontColor=#475569;fontStyle=1;spacing=0;" vertex="1" parent="1">
