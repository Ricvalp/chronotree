        <object id="encoders-28" label="&lt;b&gt;Previous command&lt;/b&gt;&lt;br&gt;&lt;br&gt;7 joints + gripper + 1 availability&lt;br&gt;Joint fields zeroed when disabled&lt;br&gt;Conditioning command unavailable" tooltip="model.condition_on_previous_joint_commands defaults to true. False removes only the seven commanded joint targets; the gripper command and availability flag remain. Unavailable commands, including conditioning/reset commands, are always zeroed.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=18;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
