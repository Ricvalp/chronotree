    <mxGraphModel dx="1800" dy="2110" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2110" math="0" shadow="0" background="#FFFFFF" adaptiveColors="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" value="Architecture" parent="0" />
        <mxCell id="notes" value="Reading notes" parent="0" />
        <mxCell id="decoder-1" value="Action-query conditional flow matching" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=36;fontColor=#0F172A;fontStyle=1;spacing=0;" vertex="1" parent="1">
