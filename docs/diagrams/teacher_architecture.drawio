          </mxCell>
        </object>
        <object id="decoder-10" label="&lt;b&gt;Flow interpolation time u&lt;/b&gt;&lt;br&gt;&lt;br&gt;16 sine + 16 cosine features&lt;br&gt;Linear 32 → 256 → SiLU&lt;br&gt;Linear 256 → 256" tooltip="action_flow.py: ActionFlow.time_in. u is the flow interpolation time; it is independent of the source-local episode clocks in the observation context.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="48" y="495" width="340" height="175" />
          </mxCell>
        </object>
        <object id="decoder-11" label="&lt;b&gt;Add query embeddings&lt;/b&gt;&lt;br&gt;&lt;br&gt;16 action-query tokens&lt;br&gt;Shape [B, 16, 256]" tooltip="Add query embeddings&#10;16 action-query tokens&#10;Shape [B, 16, 256]">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="480" y="350" width="330" height="150" />
          </mxCell>
        </object>
        <object id="decoder-12" label="&lt;b&gt;4 decoder blocks in sequence&lt;/b&gt;&lt;br&gt;&lt;br&gt;Block 1 → … → Block 4&lt;br&gt;Each preserves [B, 16, 256]&lt;br&gt;1,053,440 parameters/block&lt;br&gt;Independent weights per block&lt;br&gt;Every block reads the same context" tooltip="4 decoder blocks in sequence&#10;Block 1 → … → Block 4&#10;Each preserves [B, 16, 256]&#10;1,053,440 parameters/block&#10;Independent weights per block&#10;Every block reads the same context">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="910" y="270" width="390" height="270" />
          </mxCell>
        </object>
        <object id="decoder-13" label="&lt;b&gt;Full observation context&lt;/b&gt;&lt;br&gt;&lt;br&gt;[B, L, 256] + validity mask&lt;br&gt;All fine leaves + current/auxiliary" tooltip="Full observation context&#10;[B, L, 256] + validity mask&#10;All fine leaves + current/auxiliary" link="data:page/id,context">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="910" y="620" width="390" height="135" />
          </mxCell>
        </object>
        <object id="decoder-14" label="&lt;b&gt;Output projection&lt;/b&gt;&lt;br&gt;&lt;br&gt;LayerNorm → Linear 256 → 8&lt;br&gt;Velocity vθ · [B, 16, 8]&lt;br&gt;7 arm joints + gripper" tooltip="Output is velocity in normalized action space, not a Cartesian end-effector position or a raw joint command. The flow solver and action normalizer convert it.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="1410" y="305" width="342" height="180" />
          </mxCell>
        </object>
        <mxCell id="decoder-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B45309;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="decoder-9" target="decoder-11">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="decoder-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B45309;strokeWidth=2;fontFamily=Arial;fontSize=15;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="decoder-10" target="decoder-11">
          <mxGeometry as="geometry" relative="1" />
