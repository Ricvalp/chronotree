        <object id="context-15" label="&lt;b&gt;Valid context length · before padding&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lvalid ≤ 5(Hc + He) + 67&lt;br&gt;Each historical frame: ≤4 visual + 1 event token&lt;br&gt;Each full 8-frame block: ≤32 visual + 8 event = 40&lt;br&gt;Current/auxiliary: ≤64 visual + 3&lt;br&gt;Teacher retains all causal history; budget=128 is for later readers." tooltip="Valid context length · before padding&#10;Lvalid ≤ 5(Hc + He) + 67&#10;Each historical frame: ≤4 visual + 1 event token&#10;Each full 8-frame block: ≤32 visual + 8 event = 40&#10;Current/auxiliary: ≤64 visual + 3&#10;Teacher retains all causal history; budget=128 is for later readers.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
