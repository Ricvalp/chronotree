        <object id="encoders-31" label="&lt;b&gt;Command branch&lt;/b&gt;&lt;br&gt;&lt;br&gt;Linear 9 → 256 → SiLU&lt;br&gt;Linear 256 → 256" tooltip="Command branch&#10;Linear 9 → 256 → SiLU&#10;Linear 256 → 256">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="490" y="1160" width="320" height="120" />
          </mxCell>
        </object>
        <object id="encoders-32" label="&lt;b&gt;Add branches&lt;/b&gt;&lt;br&gt;&lt;br&gt;SiLU → Linear 256 → 256&lt;br&gt;One event token per frame" tooltip="event_encoder.py: EventEncoder. 204,032 parameters. Unavailable preceding commands are zeroed before their branch projection. The optional joint-command ablation applies before this projection in serial and batched paths.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
            <mxGeometry as="geometry" x="910" y="1075" width="345" height="135" />
