        </object>
        <object id="decoder-13" label="&lt;b&gt;Output projection&lt;/b&gt;&lt;br&gt;&lt;br&gt;LayerNorm → Linear 256 → 8&lt;br&gt;Velocity vθ · [B, 16, 8]&lt;br&gt;7 arm joints + gripper" tooltip="Output is velocity in normalized action space, not a Cartesian end-effector position or a raw joint command. The flow solver and action normalizer convert it.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
