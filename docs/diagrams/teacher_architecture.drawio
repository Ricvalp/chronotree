          </mxCell>
        </object>
        <object id="context-16" label="&lt;b&gt;Allocated context length · batched tensor&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lpad = 40 · maxᵢ(⌈Hcᵢ/8⌉ + ⌈Heᵢ/8⌉) + 67&lt;br&gt;Context tensor: [B, Lpad, 256]; mask: [B, Lpad]&lt;br&gt;Partial source blocks and short examples occupy padded slots.&lt;br&gt;Attention masks every invalid slot; no history truncation.&lt;br&gt;Teacher leaf mass = 1, so valid log-mass attention bias = 0." tooltip="batched_policy.py: full_history_context / packed context. Conditioning and execution are blocked separately per example. Only the fine-leaf bank is assembled; hierarchy parents are not built in the teacher tensor path.">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
