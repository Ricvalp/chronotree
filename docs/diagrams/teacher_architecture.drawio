        </object>
        <object id="encoders-33" label="&lt;b&gt;Attach metadata&lt;/b&gt;&lt;br&gt;&lt;br&gt;Same adapter as the visual tokens&lt;br&gt;Adds location / time / source fields" tooltip="Attach metadata&#10;Same adapter as the visual tokens&#10;Adds location / time / source fields" link="data:page/id,context">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=19;fontColor=#0F172A;shadow=0;" vertex="1" parent="1">
