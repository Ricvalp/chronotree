# Copy to hpc/site.env and fill these absolute shared paths. No drivers are changed.
STMEM_REPO_ROOT=/hpc/home/phi/rvalperga/chronotree
STMEM_DATA_ROOT=/hpc/home/phi/rvalperga/data/robomme-data
STMEM_CACHE_ROOT=/hpc/home/phi/rvalperga/data/chronotree-cache
STMEM_RUN_ROOT=/hpc/home/phi/rvalperga/chronotree/runs/h200_4gpu
STMEM_PYTHON=/hpc/home/phi/rvalperga/chronotree/.venv/bin/python
# Optional shell activation file, sourced by jobs (e.g. a site-written module script).
STMEM_ACTIVATE=
# Names are site-specific; gpuq is the supplied default partition, not a GPU model.
STMEM_PARTITION=gpuq
STMEM_ACCOUNT=
STMEM_QOS=
STMEM_CONSTRAINT=
STMEM_GPU_TYPE=
STMEM_PROFILE=h200_4gpu
STMEM_CPUS=16
STMEM_MEM=128G
STMEM_WALLTIME=48:00:00
STMEM_EVAL_WALLTIME=06:00:00
STMEM_MAX_CONCURRENT=4
# Optional immutable-cache staging location; empty uses shared cache directly.
STMEM_SCRATCH_ROOT=
# W&B stores every training/evaluation run locally by default; no login needed.
# Change to online only when compute-node networking and wandb login are ready.
WANDB_MODE=online
WANDB_PROJECT=chronotree
# Optional account/team name and absolute shared log root. Blank uses tracker defaults.
WANDB_ENTITY=
WANDB_DIR=
# Never put WANDB_API_KEY here. Authenticate interactively with: uv run wandb login
